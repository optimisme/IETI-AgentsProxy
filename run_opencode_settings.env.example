# Base URL of the IETI Agents server. The script also accepts the URL without /v1.
PROXY_AGENTS_BASE_URL=https://agents.ieti.site/v1

# API key created in the IETI Agents user portal.
PROXY_AGENTS_KEY=ieti_sk_replace_me

# Optional credentials for other providers used by OpenCode:
# OPENAI_API_KEY=sk_replace_me
# ANTHROPIC_API_KEY=sk-ant-replace_me
