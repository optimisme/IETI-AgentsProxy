index 0000000..9acb669
--- /dev/null
+++ b/tests/cuda/test_flashnext_vision.py
@@ -0,0 +1,119 @@
+"""Flash Next image features, rotary offsets and image-cache isolation on tiny CUDA weights."""
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from test_flashnext_forward import _model
+from tensorfold.cuda.streams import Stream
+from tensorfold.families.qwen4_exp.cuda.decode import Engine, prefill, serial_decode
+from tensorfold.families.qwen4_exp.cuda.multi import MultiDecoder
+from tensorfold.vision.qwen_cuda import EncodedVision
+
+
+def _image(w, prompt, seed, start=1):
+    generator = torch.Generator(device="cuda").manual_seed(seed)
+    features = torch.randn((4, w.cfg.hidden), device="cuda", generator=generator, dtype=torch.bfloat16)
+    positions = torch.arange(len(prompt), device="cuda", dtype=torch.int32).repeat(3, 1)
+    positions[:, start + 4:] -= 2
+    positions[:, start:start + 4] = torch.tensor(
+        [[start] * 4, [start, start, start + 1, start + 1],
+         [start, start + 1, start, start + 1]], device="cuda")
+    return EncodedVision(tuple(range(start, start + 4)), features, positions, -2)
+
+
+def _drain(decoder):
+    # A bounded loop makes a broken join/prefill path fail instead of hanging a deployment check.
+    for _ in range(256):
+        if not decoder.live():
+            return
+        decoder.finish(decoder.round())
+    pytest.fail("Flash Next vision streams did not finish after 256 rounds")
+
+
+def _reference(w, prompt, count, image=None, kv_dtype="int8"):
+    engine = Engine(w, capacity=1024, max_rows=8, prefill_rows=16, kv_dtype=kv_dtype)
+    first = prefill(engine, prompt, None, mtp=False, vision=image)
+    return serial_decode(engine, first, count, None).tokens
+
+
+@pytest.mark.parametrize("kv_dtype", ["bf16", "int8"])
+def test_image_prefill_is_chunk_invariant_and_clears_positions(kv_dtype):
+    w = _model()
+    prompt = [5, 17, 17, 17, 17] + list(range(20, 55))
+    image = _image(w, prompt, 9)
+    engines = [Engine(w, capacity=1024, max_rows=8, prefill_rows=rows, kv_dtype=kv_dtype) for rows in (16, 64)]
+    tokens = []
+    for engine in engines:
+        first = prefill(engine, prompt, None, mtp=False, vision=image)
+        assert engine.pbuf.rope_rows is None and engine.st.rope_delta == -2
+        tokens.append(serial_decode(engine, first, 8, None).tokens)
+    assert tokens[0] == tokens[1]
+    with pytest.raises(ValueError, match="from its start"):
+        prefill(engines[0], prompt, None, resume={}, vision=image)
+
+
+@pytest.mark.parametrize("kv_dtype", ["bf16", "int8"])
+def test_image_streams_match_serial_and_never_reuse_placeholder_states(kv_dtype):
+    w = _model()
+    prompt = [5, 17, 17, 17, 17] + list(range(20, 55))
+    images = [_image(w, prompt, seed) for seed in (9, 12)]
+    tower = SimpleNamespace(encode=lambda prepared, ids: prepared)
+    dec = MultiDecoder(w, slots=2, capacity=1024, depth=3, confidence=0.3, kv_dtype=kv_dtype,
+                       prefill_rows=16, vision=tower)
+    for image in images:
+        engine = Engine(w, capacity=1024, max_rows=8, prefill_rows=16, kv_dtype=kv_dtype)
+        reference = serial_decode(engine, prefill(engine, prompt, None, mtp=False, vision=image), 8, None).tokens
+        stream = Stream(prompt, 8, vision=image, stop_eos=False)
+        dec.admit(stream)
+        assert not stream.out and stream in dec.filling
+        _drain(dec)
+        assert stream.error is None and stream.out == reference and stream.cached == 0 and not dec.kept
+    assert len(dec.free) == 2
+
+
+def test_mixed_text_and_two_image_prefills_match_serial_with_mtp(monkeypatch):
+    """Exercise 0.6's shared decode/prefill forward, including two image feature sets in one pass."""
+    from tensorfold.families.qwen4_exp.cuda import multi
+
+    w = _model()
+    text = [5, 11, 13, 15, 19]
+    late_image = list(range(20, 33))
+    late_image[9:13] = [17] * 4
+    early_image = [5, 17, 17, 17, 17] + list(range(20, 55))
+    images = [_image(w, late_image, 9, start=9), _image(w, early_image, 12)]
+    refs = [_reference(w, text, 64), _reference(w, text, 8),
+            _reference(w, late_image, 16, images[0]), _reference(w, early_image, 16, images[1])]
+    encodes = []
+    tower = SimpleNamespace(encode=lambda prepared, ids: encodes.append(tuple(ids)) or prepared)
+    dec = MultiDecoder(w, slots=4, capacity=1024, depth=3, confidence=0.3,
+                       kv_dtype="int8", prefill_rows=16, vision=tower)
+    assert dec.converged
+    first = Stream(text, 64, stop_eos=False)
+    dec.admit(first)
+    dec.finish(dec.round())
+    assert first.out and not first.done
+    following = [Stream(text, 8, stop_eos=False),
+                 Stream(late_image, 16, vision=images[0], stop_eos=False),
+                 Stream(early_image, 16, vision=images[1], stop_eos=False)]
+    for stream in following:
+        dec.admit(stream)
+    original, feature_rows = multi.compute_mixed, []
+
+    def compute_mixed(*args, **kwargs):
+        features = kwargs.get("features")
+        if features is not None:
+            feature_rows.append(len(features[0]))
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(multi, "compute_mixed", compute_mixed)
+    _drain(dec)
+    streams = [first, *following]
+    assert all(stream.error is None and stream.out == ref for stream, ref in zip(streams, refs))
+    assert len(encodes) == 2 and max(feature_rows, default=0) == 8
+    assert all(stream.cached == 0 for stream in following[1:])
+    assert all(17 not in ids for ids, *_ in dec.kept)
+    assert all(stream.st.rope_delta == 0 for stream in (first, following[0]))
