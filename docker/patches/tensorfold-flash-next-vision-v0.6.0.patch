+def image_piece(vision, start: int, rows: int, *, offset: int = 0):
+    """One image prompt piece's positions and feature rows, optionally packed after other prompts."""
+    image_rows = torch.tensor(vision.rows, dtype=torch.int64, device=vision.features.device)
+    inside = ((image_rows >= start) & (image_rows < start + rows)).nonzero().flatten()
+    features = None
+    if inside.numel():
+        features = (image_rows.index_select(0, inside) - start + offset,
+                    vision.features.index_select(0, inside))
+    return vision.positions.t().contiguous()[start:start + rows], features
+
