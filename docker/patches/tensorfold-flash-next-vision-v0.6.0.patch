+"""Flash Next vision admission without downloading weights or importing accelerators."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tensorfold.serve_options import check
+from tensorfold.vision.config import validate_vision_config
+from tensorfold.vision.qwen_cuda import checkpoint_vision
+
+
+def _config():
+    return {"model_type": "qwen4_exp", "text_config": {"hidden_size": 8},
+            "vision_config": {"model_type": "qwen4_exp", "out_hidden_size": 8}}
+
+
+def _family():
+    return SimpleNamespace(model_type="qwen4_exp", title="Flash Next",
+                           package=SimpleNamespace(CUDA_KV_DTYPES=("bf16", "int8", "int4")))
+
+
+def test_flash_next_vision_is_admitted_on_cuda_and_refused_on_mlx(tmp_path):
+    config = _config()
+    (tmp_path / "config.json").write_text(json.dumps(config))
+    args = SimpleNamespace(vision=True, vision_urls=False, kv_dtype="int8", parallel="16")
+    assert validate_vision_config(config, "qwen4_exp") == config["vision_config"]
+    assert check(args, _family(), "cuda", tmp_path) is None
+    with pytest.raises(ValueError, match="Flash Next runs on the CUDA engine"):
+        check(args, _family(), "mlx", tmp_path)
+
+
+def test_flash_next_tower_requires_matching_language_width():
+    config = _config()
+    config["vision_config"]["out_hidden_size"] = 16
+    with pytest.raises(ValueError, match="output width"):
+        validate_vision_config(config, "qwen4_exp")
+
+
+@pytest.mark.parametrize("dtype", ["BF16", "F16", "F32"])
+def test_flash_next_original_floating_tower_headers_and_prefix_are_supported(tmp_path, dtype):
+    from test_vision_cuda import _checkpoint, _write_tensors
+
+    entries, _ = _checkpoint(tmp_path)
+    config = json.loads((tmp_path / "config.json").read_text())
+    config["model_type"] = config["vision_config"]["model_type"] = "qwen4_exp"
+    (tmp_path / "config.json").write_text(json.dumps(config))
+    offset, tower = 0, {}
+    for name, item in entries.items():
+        # Vontra stores the original float tower next to quantized language tensors.
+        size = (item["data_offsets"][1] - item["data_offsets"][0]) * (2 if dtype == "F32" else 1)
+        tower[name.replace("vision_tower.", "model.language_model.visual.")] = {
+            **item, "dtype": dtype, "data_offsets": [offset, offset + size]}
+        offset += size
+    _write_tensors(tmp_path, tower, offset)
+    vision, resident = checkpoint_vision(tmp_path)
+    assert vision["model_type"] == "qwen4_exp" and resident == offset
