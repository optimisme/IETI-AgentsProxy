+++ b/tests/test_flashnext_vision_memory.py
@@ -0,0 +1,113 @@
+"""Flash Next keeps image encoder headroom when admitting or growing CUDA lanes."""
+
+import importlib
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from tensorfold.cuda.memory_gate import MemoryGate, NoRoom
+from tensorfold.cuda.streams import Stream
+from tests.test_cuda_geometry import allocations  # noqa: F401 (CPU-only Triton import fixture)
+
+pytestmark = pytest.mark.torch
+GIB = 1024**3
+
+
+class Slot:
+    """Cache byte counts without allocating tensors or touching an accelerator."""
+
+    def __init__(self, capacity):
+        self.capacity, self.limit = capacity, 65536
+        self.resizes = []
+
+    def cache_bytes(self, rows=None):
+        return (self.capacity if rows is None else rows) * (GIB // 8192)
+
+    def layer_bytes(self, rows):
+        return GIB // 4
+
+    def resize(self, rows):
+        old = self.cache_bytes()
+        self.capacity = rows
+        self.resizes.append(rows)
+        return self.cache_bytes() - old
+
+    def reset(self, weights):
+        pass
+
+
+def decoder(module, monkeypatch, *, capacity=256, busy=False, available=5 * GIB):
+    """A real memory gate, fake cache sizes, and an encoder whose invocation is observable."""
+
+    free = [available]
+    encode = Mock(return_value=object())
+    dec = module.MultiDecoder.__new__(module.MultiDecoder)
+    dec.w = SimpleNamespace(mtp=None)
+    dec.depth, dec.capacity, dec.prefill_rows = 3, 65536, 16
+    dec.vision, dec.vision_workspace = SimpleNamespace(encode=encode), 4 * GIB
+    dec.memory_gate = MemoryGate(100 * GIB, reserve=2 * GIB + dec.vision_workspace,
+                                 live=lambda: free[0])
+    slot = Slot(capacity)
+    dec.free, dec.kept, dec.keep = [slot], [], 8
+    dec.streams = {1: SimpleNamespace(waiting=False, st=Slot(256))} if busy else {}
+    dec.filling, dec.fills, dec.held, dec.next_id = [], {}, {}, 2
+    dec.buf, dec.mbuf, dec.pbuf = SimpleNamespace(rows=8), None, SimpleNamespace()
+    monkeypatch.setattr(module, "_slot", lambda *args: SimpleNamespace())
+    monkeypatch.setattr(module, "prefill_begin", lambda *args, **kwargs: 0)
+    monkeypatch.setattr(module.torch.cuda, "is_available", lambda: False)
+    monkeypatch.setattr(module.torch.cuda, "empty_cache", lambda: None)
+    return dec, slot, free, encode
+
+
+@pytest.mark.parametrize("busy", [False, True], ids=["alone", "other-lane"])
+@pytest.mark.parametrize("capacity,prompt_rows", [(256, 300), (8192, 10)],
+                         ids=["kv-needs-growth", "kv-already-fits"])
+def test_image_waits_before_encoder_without_workspace(allocations, monkeypatch, busy, capacity, prompt_rows):  # noqa: F811
+    module = importlib.import_module("tensorfold.families.qwen4_exp.cuda.multi")
+    dec, slot, _, encode = decoder(module, monkeypatch, capacity=capacity, busy=busy)
+    prepared = object()
+    request = Stream([1] * prompt_rows, 8, vision=prepared)
+
+    with pytest.raises(NoRoom, match="wait|memory|workspace"):
+        dec.admit(request)
+
+    encode.assert_not_called()
+    assert request.vision is prepared                 # the scheduler can retry the same image
+    assert not dec.filling and not dec.fills
+    assert sum(state is slot for state in dec.free) == 1
+    assert all(rows <= capacity for rows in slot.resizes)
+
+
+def test_waiting_image_is_admitted_when_workspace_returns(allocations, monkeypatch):  # noqa: F811
+    module = importlib.import_module("tensorfold.families.qwen4_exp.cuda.multi")
+    dec, slot, free, encode = decoder(module, monkeypatch)
+    prepared = object()
+    request = Stream([1] * 300, 8, vision=prepared)
+    with pytest.raises(NoRoom):
+        dec.admit(request)
+    encode.assert_not_called()
+
+    free[0] = 8 * GIB
+    dec.admit(request)
+
+    encode.assert_called_once_with(prepared, request.prompt)
+    assert request.st is slot and request in dec.filling
+    assert request.vision is None
+    assert dec.free == [] and slot.capacity == 8192
+
+
+def test_lone_decoding_lane_ends_without_spending_vision_workspace(allocations, monkeypatch):  # noqa: F811
+    module = importlib.import_module("tensorfold.families.qwen4_exp.cuda.multi")
+    dec, slot, _, encode = decoder(module, monkeypatch)
+    slot.pos = slot.mtp_len = 254
+    request = Stream([1] * 10, 16, sid=3, st=slot, out=[2, 3])
+    dec.free, dec.streams = [], {request.sid: request}
+
+    ended = dec._make_room()
+
+    assert ended == [request] and request.done and not request.waiting
+    assert isinstance(request.error, RuntimeError) and "vision workspace" in str(request.error)
+    assert dec.memory_gate.ends == 1 and not dec.streams
+    assert dec.free == [slot] and slot.resizes == []
+    encode.assert_not_called()
