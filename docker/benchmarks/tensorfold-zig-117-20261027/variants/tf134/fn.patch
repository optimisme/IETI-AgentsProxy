+//! Rows from which a pass takes the prompt tiles in place of the row kernels (each bit for bit the other):
+//! TF_TILE_EXPERTS_ROWS and TF_TILE_MATMUL_ROWS, default 64 each (the read-out's: TF_FLASHNEXT_READOUT_ROWS).
+const std = @import("std");
+
+fn read(comptime name: [:0]const u8) usize {
+    // the name in the struct gives each knob its own cache (a struct that captures nothing is one type for all)
+    const Cached = struct {
+        const knob = name;
+        var rows: ?usize = null;
+    };
+    if (Cached.rows) |n| return n;
+    const text = std.mem.span(std.c.getenv(name) orelse "");
+    const n = std.fmt.parseInt(usize, text, 10) catch 64;
+    Cached.rows = n;
+    return n;
+}
+
+pub fn experts() usize {
+    return read("TF_TILE_EXPERTS_ROWS");
+}
+
+pub fn matmul() usize {
+    return read("TF_TILE_MATMUL_ROWS");
+}
