+    tail: std.atomic.Value(u32) = .init(0), // the next slot a worker claims
+    stopping: std.atomic.Value(bool) = .init(false),
+    threads: [max_workers]std.Thread = undefined,
+    spawned: usize = 0,
+
+    /// TF_FLASHNEXT_PLE_PREFETCH workers (default 8; 0: no prefetch, null).
+    pub fn create(gpa: std.mem.Allocator, io: std.Io) !?*Prefetch {
+        const n = if (std.c.getenv("TF_FLASHNEXT_PLE_PREFETCH")) |v| std.fmt.parseInt(usize, std.mem.span(v), 10) catch 8 else 8;
+        if (n == 0) return null;
+        const p = try gpa.create(Prefetch);
+        p.* = .{ .io = io };
+        errdefer p.destroy(gpa);
+        while (p.spawned < @min(n, max_workers)) : (p.spawned += 1) p.threads[p.spawned] = try std.Thread.spawn(.{}, work, .{p});
+        return p;
+    }
+
+    pub fn destroy(p: *Prefetch, gpa: std.mem.Allocator) void {
+        p.stopping.store(true, .release);
+        _ = p.head.fetchAdd(0, .release);
+        p.io.futexWake(u32, &p.head.raw, max_workers);
+        for (p.threads[0..p.spawned]) |th| th.join();
+        gpa.destroy(p);
+    }
+
+    /// Queue a readahead (single producer: the lane host's thread); dropped when the ring is full.
+    pub fn push(p: *Prefetch, it: Item) void {
+        const h = p.head.load(.monotonic);
+        if (h -% p.tail.load(.acquire) >= cap) return;
+        p.ring[h % cap] = it;
+        p.head.store(h +% 1, .release);
+    }
+
+    /// Wake the workers for what `push` queued.
+    pub fn kick(p: *Prefetch) void {
+        p.io.futexWake(u32, &p.head.raw, @intCast(p.spawned));
+    }
+
+    fn work(p: *Prefetch) void {
+        while (true) {
+            const t = p.tail.load(.acquire);
+            const h = p.head.load(.acquire);
+            if (t == h) {
+                if (p.stopping.load(.acquire)) return;
+                p.io.futexWaitUncancelable(u32, &p.head.raw, h);
+                continue;
+            }
+            if (p.tail.cmpxchgWeak(t, t +% 1, .acq_rel, .acquire) != null) continue;
+            const it = p.ring[t % cap];
+            _ = linux.fadvise(it.fd, @intCast(it.offset), it.len, linux.POSIX_FADV.WILLNEED);
+        }
+    }
+};
diff --git a/zig/src/families/flashnext/cuda_ple_stage.zig b/zig/src/families/flashnext/cuda_ple_stage.zig
new file mode 100644
index 00000000..875e7d88
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ple_stage.zig
@@ -0,0 +1,88 @@
+//! The next prompt chunk's n-gram rows, gathered on a host thread while this chunk runs (Python's stage-ahead for
+//! prompt pieces): a chunk's own gather overlaps only the embedding and layer 0, so a long prompt otherwise waits
+//! on the drive at layer 1 of every chunk. TF_FLASHNEXT_PLE_AHEAD=0 turns it off.
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const Gather = @import("cuda_batch_state.zig").Gather;
+
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_PLE_AHEAD") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+pub const Ahead = struct {
+    gpa: std.mem.Allocator,
+    thread: ?std.Thread = null,
+    gather: Gather = undefined,
+    /// The rows asked, the history they follow, and that history advanced past them by the gather.
+    ids: std.ArrayList(u32) = .empty,
+    from: [2]i64 = undefined,
+    hist: [2]i64 = undefined,
+    emb: []u16 = &.{},
+    xs: []f32 = &.{},
+
+    pub fn create(gpa: std.mem.Allocator) !*Ahead {
+        const a = try gpa.create(Ahead);
+        a.* = .{ .gpa = gpa };
+        return a;
+    }
+
+    pub fn destroy(a: *Ahead) void {
+        a.join();
+        a.ids.deinit(a.gpa);
+        a.gpa.free(a.emb);
+        a.gpa.free(a.xs);
+        a.gpa.destroy(a);
+    }
+
+    fn join(a: *Ahead) void {
+        if (a.thread) |th| th.join();
+        a.thread = null;
+    }
+
+    /// Start gathering `ids` after `from` (`width` values a row); a gather still running is waited for first.
+    pub fn start(a: *Ahead, ngram: *const ple.Ngram, io: std.Io, from: [2]i64, ids: []const u32, width: usize) !void {
+        a.join();
+        a.ids.clearRetainingCapacity();
+        try a.ids.appendSlice(a.gpa, ids);
+        if (a.emb.len < ids.len * width) {
+            a.gpa.free(a.emb);
+            a.emb = &.{};
+            a.gpa.free(a.xs);
+            a.xs = &.{};
+            a.emb = try a.gpa.alloc(u16, ids.len * width);
+            a.xs = try a.gpa.alloc(f32, ids.len * width / 32);
+        }
+        a.from = from;
+        a.hist = from;
+        a.gather = .{ .ngram = ngram, .history = a.hist[0..], .ids = a.ids.items, .emb = a.emb[0 .. ids.len * width], .xs = a.xs[0 .. ids.len * width / 32], .io = io };
+        a.thread = try std.Thread.spawn(.{}, Gather.main, .{&a.gather});
+    }
+
+    /// The rows of `ids` after `history` into emb and xs, history advanced past them, when the last start asked
+    /// exactly those; false (nothing written) otherwise, the gather left for its own chunk: another stream's
+    /// pass (a lone decode verify) may come between a prompt's chunks.
+    pub fn take(a: *Ahead, ngram: *const ple.Ngram, history: *[2]i64, ids: []const u32, emb: []u16, xs: []f32) bool {
+        if (a.thread == null or a.gather.ngram != ngram) return false;
+        if (!std.mem.eql(i64, &a.from, history) or !std.mem.eql(u32, a.ids.items, ids)) return false;
+        a.join();
+        if (a.gather.failed != null) return false;
+        @memcpy(emb, a.gather.emb);
+        @memcpy(xs, a.gather.xs);
+        history.* = a.hist;
+        return true;
+    }
+};
+
+/// The two-token history after `ids` follow `history`.
+pub fn after(history: [2]i64, ids: []const u32) [2]i64 {
+    if (ids.len >= 2) return .{ ids[ids.len - 2], ids[ids.len - 1] };
+    if (ids.len == 1) return .{ history[1], ids[0] };
+    return history;
+}
+
+test "the history after a chunk keeps its last two tokens" {
+    try std.testing.expectEqual([2]i64{ 5, 6 }, after(.{ 1, 2 }, &.{ 4, 5, 6 }));
+    try std.testing.expectEqual([2]i64{ 2, 9 }, after(.{ 1, 2 }, &.{9}));
+    try std.testing.expectEqual([2]i64{ 1, 2 }, after(.{ 1, 2 }, &.{}));
+}
diff --git a/zig/src/families/flashnext/cuda_ple_windows.zig b/zig/src/families/flashnext/cuda_ple_windows.zig
new file mode 100644
index 00000000..c9a3031f
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ple_windows.zig
@@ -0,0 +1,142 @@
+//! Independent stream histories share one token-major table gather without sharing their hash state.
+const std = @import("std");
+const ple = @import("cuda_ple.zig");
+const pool = @import("cuda_ple_pool.zig");
+
+pub const Window = struct { history: []i64, tokens: []const u32 };
+
+pub fn enabled() bool {
+    const value = std.c.getenv("TF_FLASHNEXT_PLE_BATCH") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(value), "0");
+}
+
+/// Groups a shared pass; single windows and the explicit control use the upstream path.
+pub fn gather(g: anytype) !bool {
+    if (g.lanes.len <= 1 or g.lanes.len > 32 or !enabled()) return false;
+    var windows: [32]Window = undefined;
+    var row: usize = 0;
+    for (g.lanes, 0..) |l, i| {
+        windows[i] = .{ .history = l.seq.history[0..], .tokens = g.ids[row..][0..l.rows] };
+        row += l.rows;
+    }
+    try g.ngram.rowsMany(windows[0..g.lanes.len], g.emb, g.xs);
+    return true;
+}
+
+pub fn rows(g: anytype, windows: []const Window, out: []u16, xs: []f32) !void {
+    if (windows.len == 0 or windows.len > 32) return error.UnexpectedTensor;
+    const h = g.hash.n - 1;
+    if (h >= ple.max_n) return error.UnexpectedTensor;
+    var total: usize = 0;
+    for (windows, 0..) |w, i| {
+        if (w.history.len != h or w.tokens.len == 0) return error.UnexpectedTensor;
+        for (windows[0..i]) |prior| {
+            const begin = @intFromPtr(w.history.ptr);
+            const other = @intFromPtr(prior.history.ptr);
+            if (begin < other + h * 8 and other < begin + h * 8) return error.UnexpectedTensor;
+        }
+        total += w.tokens.len;
+    }
+    if (out.len != total * g.width() or xs.len != out.len / 32) return error.UnexpectedTensor;
+    const ids = try g.gpa.alloc(i64, total * g.hash.heads);
+    defer g.gpa.free(ids);
+    var histories: [32][ple.max_n]i64 = undefined;
+    var at: usize = 0;
+    for (windows, 0..) |w, i| {
+        const n = w.tokens.len * g.hash.heads;
+        @memcpy(histories[i][0..h], w.history);
+        for (w.tokens, 0..) |token, t| {
+            try ple.lastIds(g.hash, histories[i][0..h], @intCast(token), ids[at + t * g.hash.heads ..][0..g.hash.heads]);
+            for (0..h - 1) |j| histories[i][j] = histories[i][j + 1];
+            histories[i][h - 1] = token;
+        }
+        at += n;
+    }
+    try gatherIds(g, ids, out, xs);
+    for (windows, 0..) |w, i| @memcpy(w.history, histories[i][0..h]);
+}
+
+const Split = struct {
+    g: *const ple.Ngram,
+    ids: []const i64,
+    out: []u16,
+    per: usize,
+
+    fn part(ctx: *const anyopaque, i: usize) anyerror!void {
+        const s: *const Split = @ptrCast(@alignCast(ctx));
+        const lo = @min(s.ids.len, i * s.per);
+        const a = traceUs();
+        const ca = if (a != 0) cpuUs() else 0;
+        defer if (a != 0 and i < part_us.len) {
+            part_us[i] = .{ a, traceUs() };
+            part_cpu[i] = cpuUs() - ca;
+        };
+        try s.g.fill(s.ids, s.out, lo, @min(s.ids.len, lo + s.per));
+    }
+};
+
+/// TF_HOST_TRACE=1: each part's start and end µs in the last gather (diagnostics only).
+var part_us: [pool.max_parts][2]u64 = undefined;
+var part_cpu: [pool.max_parts]u64 = undefined;
+
+fn cpuUs() u64 {
+    const c = @import("sys").c;
+    var t: c.timespec = undefined;
+    _ = c.clock_gettime(c.CLOCK.THREAD_CPUTIME_ID, &t);
+    return @as(u64, @intCast(t.sec)) * 1_000_000 + @as(u64, @intCast(t.nsec)) / 1000;
+}
+
+/// TF_HOST_TRACE=1: monotonic µs (0 when tracing is off; diagnostics only).
+fn traceUs() u64 {
+    const v = std.c.getenv("TF_HOST_TRACE") orelse return 0;
+    if (!std.mem.eql(u8, std.mem.span(v), "1")) return 0;
+    const c = @import("sys").c;
+    var t: c.timespec = undefined;
+    _ = c.clock_gettime(c.CLOCK.MONOTONIC, &t);
+    return @as(u64, @intCast(t.sec)) * 1_000_000 + @as(u64, @intCast(t.nsec)) / 1000;
+}
+
+fn faults() [2]i64 {
+    var r: std.c.rusage = undefined;
+    _ = std.c.getrusage(std.c.rusage.SELF, &r);
+    return .{ @intCast(r.minflt), @intCast(r.majflt) };
+}
+
+fn gatherIds(g: *const ple.Ngram, ids: []const i64, out: []u16, xs: []f32) !void {
+    const items = ids.len;
+    const width = g.width();
+    const parts = pool.partsFor(items);
+    const t0 = traceUs();
+    const f0 = if (t0 != 0) faults() else .{ 0, 0 };
+    if (parts <= 1 or g.pool == null) {
+        try g.fill(ids, out, 0, items);
+    } else {
+        const split: Split = .{ .g = g, .ids = ids, .out = out, .per = (items + parts - 1) / parts };
+        try g.pool.?.run(parts, .{ .ctx = &split, .run = Split.part });
+    }
+    const t1 = traceUs();
+    defer if (t0 != 0) {
+        const f1 = faults();
+        var last_start: u64 = 0;
+        var longest: u64 = 0;
+        var busy: u64 = 0;
+        var cpu: u64 = 0;
+        if (parts > 1) for (part_us[0..@min(parts, part_us.len)], part_cpu[0..@min(parts, part_us.len)]) |pu, pc| {
+            last_start = @max(last_start, pu[0] - t0);
+            longest = @max(longest, pu[1] - pu[0]);
+            busy += pu[1] - pu[0];
+            cpu += pc;
+        };
+        std.debug.print("ple gather items={d} parts={d}: fill {d} us, sums {d} us, minflt {d}, majflt {d}, last start {d} us, longest part {d} us, busy {d} us, cpu {d} us\n", .{ items, parts, t1 - t0, traceUs() - t1, f1[0] - f0[0], f1[1] - f0[1], last_start, longest, busy, cpu });
+    };
+    for (0..items / g.hash.heads) |t| {
+        const row = out[t * width ..][0..width];
+        if (g.format == .mlx and g.scale != 1) {
+            for (row) |*v| {
+                const f: f32 = @bitCast(@as(u32, v.*) << 16);
+                v.* = ple.toBf16(f * g.scale);
+            }
+        }
+        ple.sumGroups(row, xs[t * (width / 32) ..][0 .. width / 32]);
+    }
+}
