+//! A prompt chunk and a round's drafted windows in one pass (Python's compute_mixed): each pass runs its own
+//! layer fronts on its own scratch; each layer's experts run once over the chunk's rows and the round's.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const parts = @import("cuda_batch_state.zig");
+const zs = @import("cuda_zero_slice.zig");
+const ple_ahead = @import("cuda_ple_stage.zig");
+const media = @import("cuda_media.zig");
+
+const dims = wt.dims;
+const slots = wt.slots;
+const streams = wt.streams;
+const ple_layer = wt.ple_layer;
+
+/// One pass's side: its rows' n-gram gather and the layer fronts (`Pass.chunk`'s loop up to the experts).
+fn Front(comptime P: type) type {
+    return struct {
+        const Self = @This();
+
+        p: *P,
+        ids: []const u32 = &.{},
+        gather: parts.Gather = undefined,
+        thread: ?std.Thread = null,
+        took: bool = false,
+        ahead_on: bool = false,
+        from: [2]i64 = undefined,
+
+        fn begin(f: *Self, ids: []const u32, pos0: usize) !void {
+            const p = f.p;
+            const s = p.s;
+            const n = ids.len;
+            if (n == 0 or n > s.cap) return error.UnexpectedTensor;
+            if (p.lanes.len > 0) {
+                try @import("cuda_batch_lanes.zig").checkLanes(p.lanes, n);
+            } else if (pos0 + n > p.seq.cap) return error.UnexpectedTensor;
+            p.rows = n;
+            p.pos0 = pos0;
+            p.pending = null;
+            p.pending_f32 = false;
+            p.y16 = false;
+            p.y_from = 0;
+            p.wts_from = 0;
+            f.ids = ids;
+            try s.ready();
+            const emb = s.hostEmb(n);
+            const xs = s.hostXs(n);
+            f.gather = .{ .ngram = p.m.ngram, .history = p.seq.history[0..], .ids = ids, .emb = emb, .xs = xs, .io = p.io, .lanes = p.lanes };
+            f.ahead_on = p.lanes.len == 0 and ple_ahead.enabled();
+            f.from = p.seq.history.*;
+            f.took = f.ahead_on and (if (s.ahead) |a| a.take(p.m.ngram, p.seq.history, ids, emb, xs) else false);
+            if (!f.took) f.thread = try std.Thread.spawn(.{}, parts.Gather.main, .{&f.gather});
+            try p.stage(ids);
+            if (p.m.table_dense) {
+                try p.tri.embedDense(s.ids, p.m.table_w, s.h, dims, streams, n);
+            } else {
+                try p.tri.embed(s.ids, p.m.table_w, p.m.table_s, p.m.table_b, s.h, dims, streams, n);
+            }
+            try media.inject(p.seq.media, p.lanes, p.stream, s.h, p.pos0, n);
+        }
+
+        fn join(f: *Self) void {
+            if (f.thread) |th| th.join();
+            f.thread = null;
+        }
+
+        /// The layer up to its experts: mixed holds the rows' expert input after it.
+        fn layer(f: *Self, lw: anytype, l: usize) !void {
+            const p = f.p;
+            const s = p.s;
+            const n = p.rows;
+            if (l == ple_layer) {
+                f.join();
+                if (f.gather.failed) |err| return err;
+                if (f.ahead_on and p.next.len > 0 and p.next.len <= s.cap) {
+                    if (s.ahead == null) s.ahead = try ple_ahead.Ahead.create(p.gpa);
+                    try s.ahead.?.start(p.m.ngram, p.io, ple_ahead.after(f.from, f.ids), p.next, dims);
+                }
+                try p.upload(s.ple_emb, std.mem.sliceAsBytes(f.gather.emb));
+                try p.upload(s.ple_xs, std.mem.sliceAsBytes(f.gather.xs));
+                try s.uploaded();
+                if (p.pending != null) try p.writeback(0, n);
+                try p.pleBlock(lw, f.ids);
+            }
+            try p.writeback(0, n);
+            try p.readoutKeep(lw.attn_hc, 0, n, .{});
+            p.zero_slices = zs.usable(s.part_zero, 0, p.m.collective != null, lw.out.native != null);
+            if (lw.linear) {
+                try p.gdnBlock(lw, l, wt.linearIndex(l), .{});
+            } else try p.attnBlockKeep(lw, wt.attnIndex(l), .{});
+            const sl = zs.slices(p.zero_slices, s.cap, n, p.out_slices);
+            p.zero_slices = false;
+            try p.tri.hcWriteback(s.h, s.h, s.pss, s.part, "*fp32", s.inj, s.dummy, "*bf16", s.dummy, "*bf16", sl.stride, n, dims, streams, 4, 1, 1, sl.count);
+            try p.readoutKeep(lw.mlp_hc, 0, n, .{});
+        }
+    };
+}
+
+/// `p`'s prompt chunk `pids` at pos0 and `d`'s round over `dids`, on the same stream and weights, each on its own
+/// scratch; p's scratch holds both passes' rows for the experts. Each pass's head as its lone pass runs it.
+pub fn run(comptime P: type, p: *P, pids: []const u32, pos0: usize, d: *P, dids: []const u32) !void {
+    if (p.s.cap < pids.len + dids.len or p.lanes.len != 0 or d.lanes.len == 0) return error.UnexpectedTensor;
+    var fp: Front(P) = .{ .p = p };
+    var fd: Front(P) = .{ .p = d };
+    defer fp.join();
+    defer fd.join();
+    try fp.begin(pids, pos0);
+    try fd.begin(dids, 0);
+    const n = p.rows;
+    const dn = d.rows;
+    for (p.m.layers, d.m.layers, 0..) |*lw, *dw, l| {
+        // the round's front first: its write-back reads the last experts' rows past the chunk's in p's scratch,
+        // which p's own front may reuse
+        try fd.layer(dw, l);
+        try fp.layer(lw, l);
+        try p.copy(p.s.mixed + n * dims * 2, d.s.mixed, dn * dims * 2);
+        p.rows = n + dn;
+        p.y16 = false;
+        p.moeBlockKeep(lw, .{}) catch |err| {
+            p.rows = n;
+            return err;
+        };
+        p.rows = n;
+        p.pending = l;
+        d.pending = l;
+        d.y_from = p.s.y + n * slots * dims * 4;
+        d.wts_from = p.s.wts + n * slots * 4;
+    }
+    try d.head(null);
+    d.y_from = 0;
+    d.wts_from = 0;
+    try p.head(null);
+}
