+/// TF_QWEN_LIVE_CHUNK (default 2048, at least 64; max_rows or more: off): a stepped cut's most rows while other
+/// streams decode, so they wait one shorter pass for their next round. Cuts stay inside the cold pass's, where marks
+/// and resumes stand.
+fn liveChunk() usize {
+    const Once = struct {
+        var rows: ?usize = null;
+    };
+    if (Once.rows) |r| return r;
+    const text = std.c.getenv("TF_QWEN_LIVE_CHUNK");
+    const asked = if (text) |t| std.fmt.parseInt(usize, std.mem.span(t), 10) catch 2048 else 2048;
+    const r = @min(@max(asked, 64), E.max_rows);
+    Once.rows = r;
+    return r;
+}
+
+/// TF_LANES_PHASES=1: each stepped cut's rows and wall time on stderr (diagnostics only).
+fn phases() bool {
+    const v = std.c.getenv("TF_LANES_PHASES") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+fn nowNs() u64 {
+    var t: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &t);
+    return @as(u64, @intCast(t.sec)) * 1_000_000_000 + @as(u64, @intCast(t.nsec));
+}
