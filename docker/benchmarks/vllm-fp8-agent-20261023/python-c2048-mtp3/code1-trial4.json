      "content": "```python\n\"\"\"\nLRU Cache implementation with type hints, docstrings, and extensive unit tests.\n\nThis module provides a generic LRU (Least Recently Used) cache implementation\nthat evicts the least recently used items when the cache reaches its capacity.\n\"\"\"\n\nfrom collections import OrderedDict\nfrom typing import Generic, TypeVar, Optional, List, Tuple, Any\n\n# Type variables for generic key and value types\nK = TypeVar('K')\nV = TypeVar('V')\n\n\nclass LRUCache(Generic[K, V]):\n    \"\"\"\n    A generic LRU (Least Recently Used) cache implementation.\n\n    This cache stores key-value pairs and evicts the least recently used\n    entries when the cache exceeds its maximum capacity. It uses an\n    OrderedDict internally to maintain access order.\n\n    Attributes:\n        capacity (int): The maximum number of items the cache can hold.\n        _cache (OrderedDict): Internal storage for key-value pairs.\n\n    Example:\n        >>> cache = LRUCache[int, str](capacity=2)\n        >>> cache.put(1, \"one\")\n        >>> cache.put(2, \"two\")\n        >>> cache.get(1)\n        'one",
