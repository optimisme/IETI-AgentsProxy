      "content": "```python\n\"\"\"\nLRU Cache Implementation with Type Hints, Docstrings, and Extensive Unit Tests.\n\nThis module provides a Least Recently Used (LRU) cache implementation using\na doubly-linked list and a hash map for O(1) get and put operations.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import OrderedDict\nfrom typing import Any, Optional, TypeVar, Generic\n\nK = TypeVar(\"K\")\nV = TypeVar(\"V\")\n\n\nclass LRUCache(Generic[K, V]):\n    \"\"\"\n    A Least Recently Used (LRU) cache with a fixed capacity.\n\n    The cache stores key-value pairs and evicts the least recently used\n    item when the cache exceeds its capacity. Both get and put operations\n    are O(1) time complexity.\n\n    Attributes:\n        capacity: The maximum number of items the cache can hold.\n        _cache: An OrderedDict that maintains insertion order, where the\n                most recently used item is at the end.\n\n    Example:\n        >>> cache = LRUCache[int, str](capacity=2)\n        >>> cache.put(1, \"a\")\n        >>> cache.put(2, \"b\")\n       ",
      "reasoning": "",
