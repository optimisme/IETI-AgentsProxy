+    var h = [_]i64{42};
+    var out: [6 * 64]u16 = @splat(0xcafe);
+    var xs: [6 * 2]f32 = @splat(123);
+    const alias = [_]ple.Ngram.Window{
+        .{ .history = &h, .tokens = &tokens }, .{ .history = &h, .tokens = &tokens },
