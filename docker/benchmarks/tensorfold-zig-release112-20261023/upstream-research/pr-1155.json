  "title": "Flash Next CUDA: a shared round's greedy streams draft their MTP heads together",
  "user": {
    "login": "jschmied",
    "id": 600316,
    "node_id": "MDQ6VXNlcjYwMDMxNg==",
    "avatar_url": "https://avatars.githubusercontent.com/u/600316?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/jschmied",
    "html_url": "https://github.com/jschmied",
    "followers_url": "https://api.github.com/users/jschmied/followers",
    "following_url": "https://api.github.com/users/jschmied/following{/other_user}",
    "gists_url": "https://api.github.com/users/jschmied/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/jschmied/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/jschmied/subscriptions",
    "organizations_url": "https://api.github.com/users/jschmied/orgs",
    "repos_url": "https://api.github.com/users/jschmied/repos",
    "events_url": "https://api.github.com/users/jschmied/events{/privacy}",
    "received_events_url": "https://api.github.com/users/jschmied/received_events",
    "type": "User",
