+    try std.testing.expectEqual(@as(u32, 4096), try cacheMinPrompt("4096"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("0"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("65537"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("invalid"));
+}
