+fn cacheMinPrompt(value: ?[]const u8) !u32 {
+    const text = value orelse return 4096;
+    const n = std.fmt.parseInt(u32, text, 10) catch return error.BadCacheMinPrompt;
+    if (n < 256 or n > 65536) return error.BadCacheMinPrompt;
+    return n;
+}
