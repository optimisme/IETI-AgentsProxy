+test "IETI 1024 threshold reuses short conversation history and preserves exact continuation and branch state" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 1024 }, 1 << 20);
+    defer s.deinit();
+    var ids: [1850]u32 = undefined;
+    for (&ids, 0..) |*id, i| id.* = @intCast(i % 97);
+    var plan = try s.begin(a, ids[0..1800], 1799, &.{}, &.{}, null);
+    try std.testing.expectEqualSlices(u32, &.{1799}, plan.marks);
+    try std.testing.expectEqual(fresh(ids[0..1800]), f.pass(&s, ids[0..1800], plan));
+    plan = try s.begin(a, &ids, 1849, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 1799), plan.from);
+    try std.testing.expectEqual(fresh(&ids), f.pass(&s, &ids, plan));
+    ids[1810] +%= 1;
+    plan = try s.begin(a, &ids, 1849, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 1799), plan.from);
+    try std.testing.expectEqual(fresh(&ids), f.pass(&s, &ids, plan));
+    try std.testing.expect(s.held <= s.budget);
