+fn cacheMinPrompt(value: ?[]const u8) !u32 {
+    const text = value orelse return 4096;
+    const n = std.fmt.parseInt(u32, text, 10) catch return error.BadCacheMinPrompt;
+    if (n < 256 or n > 65536) return error.BadCacheMinPrompt;
+    return n;
+}
+
+fn cacheBranchLRU(value: ?[]const u8) !bool {
+    const text = value orelse return false;
+    if (std.mem.eql(u8, text, "0")) return false;
+    if (std.mem.eql(u8, text, "1")) return true;
+    return error.BadCacheBranchLRU;
+}
+
+test "IETI branch LRU opt-in is strict and preserves the stock default" {
+    try std.testing.expect(!try cacheBranchLRU(null));
+    try std.testing.expect(!try cacheBranchLRU("0"));
+    try std.testing.expect(try cacheBranchLRU("1"));
+    try std.testing.expectError(error.BadCacheBranchLRU, cacheBranchLRU("yes"));
+}
+
+fn cacheHistoryGap(value: ?[]const u8) !u32 {
+    const text = value orelse return 0;
+    const n = std.fmt.parseInt(u32, text, 10) catch return error.BadCacheHistoryGap;
+    if (n > 8192) return error.BadCacheHistoryGap;
+    return n;
+}
+
+test "IETI history spacing defaults off and validates its byte-budget-neutral override" {
+    try std.testing.expectEqual(@as(u32, 0), try cacheHistoryGap(null));
+    try std.testing.expectEqual(@as(u32, 256), try cacheHistoryGap("256"));
+    try std.testing.expectError(error.BadCacheHistoryGap, cacheHistoryGap("8193"));
+    try std.testing.expectError(error.BadCacheHistoryGap, cacheHistoryGap("invalid"));
+}
+
+test "IETI cache threshold validates the environment override and preserves the upstream default" {
+    try std.testing.expectEqual(@as(u32, 4096), try cacheMinPrompt(null));
+    try std.testing.expectEqual(@as(u32, 1024), try cacheMinPrompt("1024"));
+    try std.testing.expectEqual(@as(u32, 4096), try cacheMinPrompt("4096"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("0"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("65537"));
+    try std.testing.expectError(error.BadCacheMinPrompt, cacheMinPrompt("invalid"));
+}
