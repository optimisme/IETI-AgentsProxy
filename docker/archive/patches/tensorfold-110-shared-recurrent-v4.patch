+
+// Shared-stream descriptor batching adapted from BobClawblaw/TensorFold's
+// shared-rounds/native-v1.0.12 pointer-table approach (MIT). Keep v1.1.0's
+// single-GPU geometry, arithmetic order, FP8 caches and rollback storage.
+struct IetiGdnSeg {
+    const __nv_bfloat16* proj;
+    __nv_bfloat16* conv;
+    float* state;
+    float* state_out;
+    __nv_bfloat16* keep_proj;
+    __nv_bfloat16* keep_hist;
+    long long row0;
+    long long rows;
+};
+static_assert(sizeof(IetiGdnSeg) == 64);
+
+extern "C" __global__ void fn_gdn_preserve_multi(const IetiGdnSeg* segs) {
+    using namespace fn_gdn;
+    const IetiGdnSeg sg = segs[blockIdx.y];
+    const size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (sg.keep_proj != nullptr && i < (size_t)sg.rows * PW) sg.keep_proj[i] = sg.proj[i];
+    if (sg.keep_hist != nullptr && i < (TAPS - 1) * C) sg.keep_hist[i] = sg.conv[i];
+}
+
+extern "C" __global__ void __launch_bounds__(256) fn_gdn_front_multi(
+        const IetiGdnSeg* segs, const int* owners, const __nv_bfloat16* __restrict__ cw,
+        const float* __restrict__ a_log, const float* __restrict__ dt_bias, float* q_all,
+        float* k_all, float* v_all, float* gb_all) {
+    const IetiGdnSeg sg = segs[owners[blockIdx.x]];
+    const __nv_bfloat16* P = sg.proj;
+    const __nv_bfloat16* cs = sg.conv;
+    float* qn = q_all + sg.row0 * fn_gdn::NK * fn_gdn::DK;
+    float* kn = k_all + sg.row0 * fn_gdn::NK * fn_gdn::DK;
+    float* v = v_all + sg.row0 * fn_gdn::NV * fn_gdn::DV;
+    float* gb = gb_all + sg.row0 * fn_gdn::NV * 2;
+    using namespace fn_gdn;
+    const int r = (int)blockIdx.x - (int)sg.row0, u = blockIdx.y, t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    if (u < NK) {
+        __shared__ float x[2][DK];
+        const int hk = u;
+        x[t / DK][t % DK] = conv_act(P, cs, cw, r, t < DK ? hk * DK + t : NK * DK + hk * DK + (t - DK));
+        __syncthreads();
+        if (warp < 2) {
+            float v4[4], ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                v4[i] = x[warp][lane * 4 + i];
+                ss = ss + v4[i] * v4[i];
+            }
+            ss = warp_sum(ss);
+            float inv = 1.0f / sqrtf(ss + 1e-6f);
+            if (warp == 0) inv = inv * (1.0f / sqrtf((float)DK));
+            float* dst = (warp == 0 ? qn : kn) + ((size_t)r * NK + hk) * DK;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) dst[lane * 4 + i] = v4[i] * inv;
+        }
+    } else {
+        const int hv = u - NK;
+        if (t < DV) v[(size_t)r * NV * DV + hv * DV + t] = conv_act(P, cs, cw, r, 2 * NK * DK + hv * DV + t);
+        else if (t == DV) {
+            const float b = __bfloat162float(P[(size_t)r * PW + C + NV * DV + hv]);
+            const float a = __bfloat162float(P[(size_t)r * PW + C + NV * DV + NV + hv]);
+            gb[((size_t)r * NV + hv) * 2] = expf(-expf(a_log[hv]) * softplusf_(a + dt_bias[hv]));
+            gb[((size_t)r * NV + hv) * 2 + 1] = bf(sigmoidf_(b));
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(128) fn_gdn_rows_multi(
+        const IetiGdnSeg* segs, const float* q, const float* k,
+        const float* v, const float* gb, float* ys) {
+    using namespace fn_gdn;
+    const IetiGdnSeg sg = segs[blockIdx.z];
+    const size_t qk = sg.row0 * NK * DK;
+    const size_t vo = sg.row0 * NV * DV;
+    gdn_rows(q + qk, k + qk, v + vo, gb + sg.row0 * NV * 2,
+             sg.state, sg.state_out, (int)sg.rows, ys + vo);
+}
+
+extern "C" __global__ void fn_gdn_shift_multi(const IetiGdnSeg* segs) {
+    using namespace fn_gdn;
+    const IetiGdnSeg sg = segs[blockIdx.y];
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= C) return;
+    __nv_bfloat16 next[TAPS - 1];
+    for (int j = 0; j < TAPS - 1; ++j) {
+        const int src = j + (int)sg.rows;
+        next[j] = src < TAPS - 1 ? sg.conv[(size_t)src * C + ch]
+                                : sg.proj[(size_t)(src - (TAPS - 1)) * PW + ch];
+    }
+    for (int j = 0; j < TAPS - 1; ++j) sg.conv[(size_t)j * C + ch] = next[j];
+}
