+//! Opt-in FP8 E4M3 KV storage. Indexer keys and pooled keys remain bf16.
+const std = @import("std");
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_KV_FP8") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+pub fn elementBytes() usize { return if (enabled()) 1 else 2; }
diff --git a/zig/src/families/flashnext/cuda_draft_batch.zig b/zig/src/families/flashnext/cuda_draft_batch.zig
new file mode 100644
index 0000000..d54c673
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_draft_batch.zig
@@ -0,0 +1,126 @@
+//! Batch MTP head projections across owners; each owner's attention cache and sampling remain independent.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const batch = @import("cuda_batch.zig");
+const mtp = @import("cuda_mtp.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+pub const Item = struct {
+    draft: *mtp.Draft,
+    next: []const u32,
+    rows: u64,
+    position: u64,
+    count: usize,
+    sampling: ?mtp.Sampling,
+    chain: *mtp.Chain,
+};
+const HeadRows = struct { draft: *mtp.Draft, next: []const u32, rows: u64 };
+fn cint(n: usize) c_int { return @intCast(n); }
+
+fn forward(comptime Tri: type, o: anytype, items: []const HeadRows, logits: u64) !void {
+    if (items.len == 0) return;
+    const e = o.e;
+    const h = o.h;
+    var n: usize = 0;
+    var cap: usize = 0;
+    var widest: usize = 0;
+    for (items, 0..) |item, i| {
+        if (item.next.len == 0 or item.next.len > mtp.max_rows or item.draft.len + item.next.len > item.draft.cap) return error.WindowTooWide;
+        for (items[0..i]) |previous| if (previous.draft == item.draft) return error.DuplicateSequence;
+        n += item.next.len;
+        cap = @max(cap, item.draft.cap);
+        widest = @max(widest, item.next.len);
+    }
+    if (items.len > 32) return error.WindowTooWide;
+    e.round_graph.clear();
+    const s = try e.reserve(@max(@as(usize, 32), n * 2));
+    const scores = try e.reserveScores(cap, widest);
+    const ids = try e.gpa.alloc(u32, n);
+    defer e.gpa.free(ids);
+    const groups = try e.gpa.alloc(batch.Lane, items.len);
+    defer e.gpa.free(groups);
+    var at: usize = 0;
+    for (items, groups) |item, *group| {
+        const d = item.draft;
+        @memcpy(ids[at..][0..item.next.len], item.next);
+        group.* = .{ .seq = .{ .media = d.media, .conv = &.{}, .state = &.{}, .kc = (&d.kc)[0..1], .vc = (&d.vc)[0..1], .ikc = (&d.ikc)[0..1], .pooled = (&d.pooled)[0..1], .tail = d.kc, .history = &d.unused_history, .cap = d.cap, .scores = scores }, .pos = d.len, .offset = at, .count = item.next.len };
+        at += item.next.len;
+    }
+    var p: batch.Pass(Tri) = .{ .gpa = e.gpa, .io = e.io, .stream = e.stream.*, .tri = o.tri, .k = &e.batch_k, .s = s,
+        .m = .{ .table_w = e.table.w.ptr, .table_s = e.table.s.ptr, .table_b = e.table.b.ptr, .table_dense = e.table.dense, .layers = (&h.layer)[0..1], .mixer = h.mixer, .head = h.draft, .ngram = &e.ngram },
+        .seq = groups[0].seq, .lanes = groups, .hooks = .{ .logits = .none }, .rows = n };
+    try p.stage(ids);
+    // ple_nrow is unused by the MTP layer. Gather conditioning rows before its shared RMS/FC kernels.
+    for (items, groups) |item, group| try p.copy(s.ple_nrow + group.offset * wt.wide * 2, item.rows, item.next.len * wt.wide * 2);
+    if (e.table.dense) {
+        try o.tri.embedDense(s.ids, e.table.w.ptr, s.ple_keys, wt.dims, wt.streams, n);
+    } else {
+        try o.tri.embed(s.ids, e.table.w.ptr, e.table.s.ptr, e.table.b.ptr, s.ple_keys, wt.dims, wt.streams, n);
+    }
+    for (items, groups) |item, group| try @import("cuda_media.zig").injectNext(item.draft.media, e.stream.*, s.ple_keys + group.offset * wt.wide * 2, item.draft.len, item.next.len);
+    try o.tri.rmsnorm(s.ple_keys, h.norm_e.ptr, s.mixed, s.xsm, wt.eps, wt.wide, n, wt.dims, wt.dims);
+    try p.lane(s.mixed, s.xsm, h.fc_e, s.dummy, s.part, n, mtp.fc_sk);
+    try p.sumSlices(s.part, s.branch, true, n * wt.dims, mtp.fc_sk);
+    try o.tri.rmsnorm(s.ple_nrow, h.norm_h.ptr, s.norm, s.gq, wt.eps, wt.wide, n, wt.wide, wt.wide);
+    try p.lane(s.norm, s.gq, h.fc_h, s.dummy, s.part, wt.streams * n, mtp.fc_sk);
+    try p.sumSlices(s.part, s.ple_gated, true, wt.streams * n * wt.dims, mtp.fc_sk);
+    try o.tri.addStreams(s.branch, s.ple_gated, s.h, n, wt.dims, wt.streams);
+    try p.writeback(0, n);
+    try p.readout(h.layer.attn_hc, 0, n);
+    try p.attnBlock(&h.layer, 0);
+    try o.tri.hcWriteback(s.h, s.h, s.pss, s.part, "*fp32", s.inj, s.dummy, "*bf16", s.dummy, "*bf16", n * wt.dims, n, wt.dims, wt.streams, 4, 1, 1, wt.out_sk);
+    try p.readout(h.layer.mlp_hc, 0, n);
+    try p.moeBlock(&h.layer);
+    p.pending = 0;
+    try p.writeback(0, n);
+    for (items, groups) |item, group| {
+        try p.copy(item.draft.out.ptr, s.h + (group.offset + group.count - 1) * wt.wide * 2, wt.wide * 2);
+        item.draft.len += group.count;
+    }
+    // Last rows are monotonically increasing: forward compaction never overwrites a later source.
+    for (groups, 0..) |group, i| {
+        const last = group.offset + group.count - 1;
+        if (last != i) {
+            try p.copy(s.h + i * wt.wide * 2, s.h + last * wt.wide * 2, wt.wide * 2);
+            try p.copy(s.pss + i * batch.pss_n * 4, s.pss + last * batch.pss_n * 4, batch.pss_n * 4);
+        }
+    }
+    try p.readout(h.mixer, 0, items.len);
+    try p.lane(s.mixed, s.xsm, h.draft, logits, s.dummy, items.len, 1);
+    for (items, 0..) |item, i| try p.copy(item.draft.dlogits.ptr, logits + i * h.ids.len * 2, h.ids.len * 2);
+    // All stack-backed token ids and shared scratch copies have landed before the caller reuses them.
+    try e.stream.synchronize();
+}
+
+pub fn run(comptime Tri: type, o: anytype, items: []const Item, logits: u64, confidence: f64) !void {
+    if (items.len == 0 or items.len > 32) return error.WindowTooWide;
+    var work: [32]HeadRows = undefined;
+    var active: [32]bool = @splat(true);
+    for (items, 0..) |item, i| {
+        item.chain.n = 0;
+        if (item.draft.drafted > item.draft.len) return error.PositionMismatch;
+        item.draft.len -= item.draft.drafted;
+        item.draft.drafted = 0;
+        work[i] = .{ .draft = item.draft, .next = item.next, .rows = item.rows };
+    }
+    try forward(Tri, o, work[0..items.len], logits);
+    for (0..mtp.max_chain) |j| {
+        var n: usize = 0;
+        for (items, 0..) |item, i| {
+            if (!active[i] or j >= item.count) continue;
+            const got = try o.pick(item.draft, item.position + j, item.sampling);
+            const low = confidence > 0 and got.prob < confidence;
+            if (low and j > 0) { active[i] = false; continue; }
+            item.chain.tokens[item.chain.n] = got.token;
+            item.chain.probs[item.chain.n] = got.prob;
+            item.chain.n += 1;
+            if (low or j + 1 >= item.count) { active[i] = false; continue; }
+            work[n] = .{ .draft = item.draft, .next = item.chain.tokens[j..][0..1], .rows = item.draft.out.ptr };
+            n += 1;
+        }
+        if (n == 0) break;
+        try forward(Tri, o, work[0..n], logits);
+        for (work[0..n]) |item| item.draft.drafted += 1;
+    }
+}
