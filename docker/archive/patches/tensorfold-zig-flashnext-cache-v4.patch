+    try std.testing.expect(try cacheBranchLRU("1"));
+    try std.testing.expectError(error.BadCacheBranchLRU, cacheBranchLRU("yes"));
+}
+
+fn cacheHistoryGap(value: ?[]const u8) !u32 {
+    const text = value orelse return 0;
+    const n = std.fmt.parseInt(u32, text, 10) catch return error.BadCacheHistoryGap;
+    if (n > 8192) return error.BadCacheHistoryGap;
