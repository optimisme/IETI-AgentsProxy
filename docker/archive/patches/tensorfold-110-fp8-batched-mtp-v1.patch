+//! Opt-in FP8 E4M3 KV storage. Indexer keys and pooled keys remain bf16.
+const std = @import("std");
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_KV_FP8") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+pub fn elementBytes() usize { return if (enabled()) 1 else 2; }
