@@ -0,0 +1,71 @@
+//! Several MTP windows in one dense/expert pass; recurrent, convolution and KV state stay per owner.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("cuda_prompt.zig");
+const batch = @import("cuda_batch.zig");
+const mtp = @import("cuda_mtp.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+pub const Window = struct { seq: *prompt.Seq, draft: *mtp.Draft, ids: []const u32 };
+fn copy(stream: cuda.Stream, dst: u64, src: u64, n: usize) !void {
+    if (n == 0) return;
+    try stream.d.check(stream.d.api.cuMemcpyDtoDAsync_v2(dst, src, n, stream.handle), "cuMemcpyDtoDAsync");
+}
+
+pub fn run(e: *prompt.Engine, comptime Tri: type, tri: Tri, windows: []const Window, logits: u64) !void {
+    if (windows.len == 0 or windows.len > 32 or e.collective != null) return error.UnsupportedVerifyBatch;
+    var count: usize = 0;
+    var cap: usize = 0;
+    var widest: usize = 0;
+    for (windows, 0..) |w, wi| {
+        if (w.ids.len == 0 or w.ids.len > mtp.max_rows or w.seq.fed + w.ids.len > w.seq.cap) return error.WindowTooWide;
+        for (windows[0..wi]) |previous| if (previous.seq == w.seq) return error.DuplicateSequence;
+        count += w.ids.len;
+        cap = @max(cap, w.seq.cap);
+        widest = @max(widest, w.ids.len);
+    }
+    e.round_graph.clear();
+    const s = try e.reserve(count);
+    const scores = try e.reserveScores(cap, widest);
+    const ids = try e.gpa.alloc(u32, count);
+    defer e.gpa.free(ids);
+    const groups = try e.gpa.alloc(batch.Lane, windows.len);
+    defer e.gpa.free(groups);
+    var at: usize = 0;
+    for (windows, groups) |w, *group| {
+        const q = w.seq;
+        const d = w.draft;
+        d.settle(q);
+        d.fed0 = q.fed;
+        d.rows = w.ids.len;
+        d.history = q.history;
+        @memcpy(d.ids[0..w.ids.len], w.ids);
+        const keeps = w.ids.len > 1;
+        if (keeps) try copy(e.stream.*, d.saved.ptr + mtp.Draft.tail_at, q.tail.ptr, wt.ple_tail_n * wt.wide * 2);
+        @memcpy(ids[at..][0..w.ids.len], w.ids);
+        group.* = .{ .seq = q.view(scores), .pos = q.fed, .offset = at, .count = w.ids.len, .keep = if (keeps) &d.keep else null, .streams = d.streams.ptr };
+        at += w.ids.len;
+    }
+    var pass: batch.Pass(Tri) = .{
+        .gpa = e.gpa,
+        .io = e.io,
+        .stream = e.stream.*,
+        .tri = tri,
+        .k = &e.batch_k,
+        .s = s,
+        .m = .{ .table_w = e.table.w.ptr, .table_s = e.table.s.ptr, .table_b = e.table.b.ptr, .table_dense = e.table.dense, .layers = e.layers[0..e.n_layers], .mixer = e.mixer, .head = e.head_q, .ngram = &e.ngram },
+        .seq = groups[0].seq,
+        .lanes = groups,
+        .hooks = .{ .logits = .all, .logits_out = logits },
+    };
+    try pass.chunk(ids, 0, null);
+    for (windows, groups) |w, group| {
+        const n = w.ids.len;
+        try copy(e.stream.*, w.draft.logits.ptr, logits + group.offset * prompt.vocabulary * 2, n * prompt.vocabulary * 2);
+        if (n > 1) try copy(e.stream.*, w.draft.saved.ptr + mtp.Draft.nrow_at, s.ple_nrow + group.offset * wt.wide * 2, n * wt.wide * 2);
+        w.seq.fed += n;
+        w.draft.open = n > 1;
+    }
+    // A later draw reads each owner's results; scratch and the gather's source IDs may now be released.
+    try e.stream.synchronize();
+}
